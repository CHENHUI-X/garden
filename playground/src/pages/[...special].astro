---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection(
    "specials",
    ({ data }) => !data.disabled,
  );
  return entries.map((entry) => ({
    params: { special: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const targetUrl = `/?open=${encodeURIComponent(entry.slug)}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{entry.data.title} · CHENHUI · 随想</title>
    <meta name="description" content={entry.data.description || "CHENHUI · 随想"} />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href="/" />
    <style>
      html,
      body {
        margin: 0;
        background: #edebe6;
        color: #161513;
        font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        html,
        body {
          background: #12110f;
          color: #ebe5da;
        }
      }
    </style>
    <script is:inline define:vars={{ targetUrl }}>
      try {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.style.background = "#12110f";
        }
      } catch (e) {}
      window.location.replace(targetUrl);
    </script>
  </head>
  <body>
    <noscript>
      <p style="padding:2rem;text-align:center">
        正在前往 <a href={targetUrl}>CHENHUI · {entry.data.title}</a>…
      </p>
    </noscript>
  </body>
</html>

---
import { BaseLayout } from "charm:layouts";
import { HomeSide } from "charm:components";
---

<BaseLayout meta={{ title: "404 · 页面未找到" }}>
  <HomeSide />
  <div class="not-found-wrapper">
    <div class="not-found-card">
      <span class="error-code">404</span>
      <h1 class="error-title">页面未找到</h1>
      <p class="error-desc">
        抱歉，你访问的页面不存在或已被移除。
      </p>
      <p class="error-quote">
        “人无法同时拥有青春和对青春的感受，但你可以随时返回首页。”
      </p>
      <div class="action-area">
        <a href="/" class="btn-home">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          返回首页
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-wrapper {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
  }
  .not-found-card {
    text-align: center;
    max-width: 480px;
    width: 100%;
    padding: 3rem 2rem;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 1.25rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
  }
  html.charm.dark .not-found-card {
    background: rgba(30, 32, 40, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
  .error-code {
    display: block;
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--charm-highlight-color), #ff8e72);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.04em;
    margin-bottom: 0.5rem;
  }
  .error-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .error-desc {
    opacity: 0.7;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }
  .error-quote {
    font-size: 0.85rem;
    font-style: italic;
    opacity: 0.55;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .action-area {
    display: flex;
    justify-content: center;
  }
  .btn-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.4rem;
    background: var(--charm-highlight-color);
    color: #ffffff;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(224, 100, 88, 0.3);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .btn-home:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 6px 20px rgba(224, 100, 88, 0.4);
  }
  .btn-home:active {
    transform: translateY(0) scale(0.98);
  }
</style>

---
import "../styles/clothesline-studio.css";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · 页面走失 · IUHNEHC</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Noto+Serif+SC:wght@400;600&display=swap"
    />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || (!saved && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="studio-ambient" aria-hidden="true">
      <div class="studio-light"></div>
    </div>
    <div class="studio-guides" aria-hidden="true"></div>

    <main class="nf-stage">
      <div class="nf-card">
        <span class="lbl nf-eyebrow">ARCHIVE · PAGE NOT FOUND</span>
        <h1 class="nf-code">404</h1>
        <p class="nf-title">这一页被风吹走了</p>
        <p class="nf-quote">「人无法同时拥有青春和对青春的感受，但随时可以回到晾衣线旁。」</p>
        <a href="/" class="nf-home-btn">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>返回 IUHNEHC</span>
        </a>
      </div>
    </main>

    <style>
      .nf-stage {
        position: relative;
        z-index: 10;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .nf-card {
        max-width: 440px;
        width: 100%;
        text-align: center;
        padding: 44px 32px;
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: 4px;
        box-shadow: var(--shadow-soft);
      }

      .nf-eyebrow {
        color: var(--accent);
        display: block;
        margin-bottom: 14px;
      }

      .nf-code {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(68px, 14vw, 96px);
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: -0.03em;
      }

      .nf-title {
        margin: 14px 0 10px;
        font-family: var(--font-serif);
        font-size: 20px;
        font-weight: 600;
      }

      .nf-quote {
        margin: 0 0 28px;
        font-family: var(--font-serif);
        font-size: 14px;
        line-height: 1.8;
        color: var(--muted);
      }

      .nf-home-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 999px;
        background: var(--ink);
        color: var(--paper);
        text-decoration: none;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: 0.08em;
        transition: transform 0.22s var(--ease), background-color 0.22s var(--ease);
      }

      .nf-home-btn:hover {
        background: var(--accent);
        color: #fff;
        transform: translateY(-2px);
      }
    </style>
  </body>
</html>

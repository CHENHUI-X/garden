---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection(
    "posts",
    ({ data }) =>
      data && !data.hidden && (import.meta.env.PROD ? data.draft !== true : true),
  );
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const targetUrl = `/?open=book&slug=${encodeURIComponent(entry.slug)}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{entry.data.title} · IUHNEHC</title>
    <meta name="description" content={entry.data.description || "IUHNEHC · 随想"} />
    <meta property="og:title" content={`${entry.data.title} · IUHNEHC`} />
    <meta property="og:description" content={entry.data.description || "IUHNEHC · 随想"} />
    <meta property="og:type" content="article" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <style>
      html,
      body {
        margin: 0;
        background: #edebe6;
        color: #161513;
        font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        html,
        body {
          background: #12110f;
          color: #ebe5da;
        }
      }
    </style>
    <script is:inline define:vars={{ targetUrl }}>
      try {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.style.background = "#12110f";
        }
      } catch (e) {}
      window.location.replace(targetUrl);
    </script>
  </head>
  <body>
    <noscript>
      <p style="padding:2rem;text-align:center">
        正在翻开书册《{entry.data.title}》：<a href={targetUrl}>点击进入</a>
      </p>
    </noscript>
  </body>
</html>

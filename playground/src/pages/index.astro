---
import { getCollection } from "astro:content";
import avatarImg from "../assets/avatar.png";
import vinylSleeveImg from "../assets/vinyl-sleeve-cover.jpg";
import { MUSIC_CONFIG } from "../config/music";
import "../styles/clothesline-studio.css";
import "../styles/vinyl-hifi.css";
import BookReaderModal from "../components/studio/BookReaderModal.astro";
import StudioModals from "../components/studio/StudioModals.astro";
import VinylPlayerModal from "../components/studio/VinylPlayerModal.astro";

// 1. Live posts collection (automatically syncs every new .md post into the 3D Book!)
const postEntries = (
  await getCollection(
    "posts",
    ({ data }) =>
      data && !data.hidden && (import.meta.env.PROD ? data.draft !== true : true),
  )
).sort(
  (a, b) =>
    (b.data.updated ?? b.data.published).valueOf() -
    (a.data.updated ?? a.data.published).valueOf(),
);

const renderedPosts = await Promise.all(
  postEntries.map(async (entry) => {
    const { Content } = await entry.render();
    const cleaned = (entry.body ?? "")
      .replace(/^---[\s\S]*?---/, "")
      .replace(/[#*`>\[\]!\-_]/g, "")
      .replace(/\s+/g, "");
    const d = entry.data.published;
    const dateStr =
      d instanceof Date
        ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`
        : String(d ?? "");
    return {
      slug: entry.slug,
      title: entry.data.title,
      description: entry.data.description ?? "",
      published: dateStr,
      category: entry.data.category ?? "随笔",
      tags: entry.data.tags ?? [],
      charCount: cleaned.length,
      plainText: cleaned,
      Content,
    };
  }),
);

const totalChars = renderedPosts.reduce((sum, p) => sum + p.charCount, 0);
const latestPost = renderedPosts[0];

// 2. Live specials collection (murmur.md + friends.md)
const specials = await getCollection("specials");
const murmurEntry = specials.find((s) => s.slug === "murmur");
const friendsEntry = specials.find((s) => s.slug === "friends");

interface MurmurImage {
  src: string;
  alt: string;
}

const murmurs: { date: string; paragraphs: string[]; images: MurmurImage[]; rawText: string }[] = [];

function extractMurmurBlocks(body: string): string[] {
  const blocks: string[] = [];
  const openTag = '<div class="murmur-item">';
  let searchFrom = 0;
  while (searchFrom < body.length) {
    const start = body.indexOf(openTag, searchFrom);
    if (start === -1) break;
    const contentStart = start + openTag.length;
    let depth = 1;
    const tagRe = /<div\b[^>]*>|<\/div>/gi;
    tagRe.lastIndex = contentStart;
    let end = body.length;
    let tagMatch: RegExpExecArray | null;
    while ((tagMatch = tagRe.exec(body)) !== null) {
      if (tagMatch[0].toLowerCase().startsWith("</")) {
        depth -= 1;
        if (depth === 0) {
          end = tagMatch.index;
          searchFrom = tagMatch.index + tagMatch[0].length;
          break;
        }
      } else {
        depth += 1;
      }
    }
    if (depth !== 0) break;
    blocks.push(body.slice(contentStart, end));
  }
  return blocks;
}

if (murmurEntry?.body) {
  for (const block of extractMurmurBlocks(murmurEntry.body)) {
    const dateMatch = /<span class="murmur-date">([^<]+)<\/span>/.exec(block);
    const date = dateMatch ? dateMatch[1].trim() : "";

    const images: MurmurImage[] = [];
    const seenSrc = new Set<string>();
    const pushImg = (src: string, alt: string) => {
      const cleanSrc = src.trim();
      if (!cleanSrc || seenSrc.has(cleanSrc)) return;
      seenSrc.add(cleanSrc);
      images.push({ src: cleanSrc, alt: alt.trim() });
    };

    const htmlImgRe = /<img\b[^>]*>/gi;
    let im: RegExpExecArray | null;
    while ((im = htmlImgRe.exec(block)) !== null) {
      const tag = im[0];
      const srcMatch = /\bsrc=(?:"([^"]+)"|'([^']+)')/i.exec(tag);
      const altMatch = /\balt=(?:"([^"]*)"|'([^']*)')/i.exec(tag);
      const src = srcMatch?.[1] ?? srcMatch?.[2] ?? "";
      const alt = altMatch?.[1] ?? altMatch?.[2] ?? "";
      if (src) pushImg(src, alt);
    }

    const mdImgRe = /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g;
    let mm: RegExpExecArray | null;
    while ((mm = mdImgRe.exec(block)) !== null) {
      pushImg(mm[2] ?? "", mm[1] ?? "");
    }

    const textOnly = block
      .replace(/<span class="murmur-date">[^<]*<\/span>/g, "")
      .replace(/<div class="murmur-images"[^>]*>[\s\S]*?<\/div>/gi, "")
      .replace(/!\[[^\]]*\]\([^)]+\)/g, "")
      .replace(/<[^>]+>/g, "")
      .trim();
    const paragraphs = textOnly
      .split(/\n\s*\n/)
      .map((p) => p.replace(/\s+/g, " ").trim())
      .filter(Boolean);
    if (date && (paragraphs.length || images.length)) {
      murmurs.push({ date, paragraphs, images, rawText: paragraphs.join(" ") });
    }
  }
}

const friends: { name: string; desc: string; href: string; avatar: string }[] = [];
if (friendsEntry?.body) {
  const cardRegex = /<a class="friend-card"[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/g;
  let fm: RegExpExecArray | null;
  while ((fm = cardRegex.exec(friendsEntry.body)) !== null) {
    const href = fm[1];
    const inner = fm[2];
    const imgMatch = /<img[^>]*src="([^"]+)"/.exec(inner);
    const nameMatch = /<span class="friend-name">([^<]+)<\/span>/.exec(inner);
    const descMatch = /<span class="friend-desc">([^<]+)<\/span>/.exec(inner);
    const rawAvatar = imgMatch?.[1] || "";
    const safeAvatar =
      !rawAvatar || rawAvatar.endsWith(".ico")
        ? avatarImg.src
        : rawAvatar;
    friends.push({
      href,
      avatar: safeAvatar,
      name: nameMatch?.[1]?.trim() || href,
      desc: descMatch?.[1]?.trim() || "",
    });
  }
}

const latestMurmur = murmurs[0] ?? {
  date: "2026-05-01",
  paragraphs: ["今天是建站的第一天。"],
  images: [],
  rawText: "今天是建站的第一天。",
};

const foundedMs = new Date("2026-05-01T00:00:00+08:00").getTime();
const daysOnline = Math.max(1, Math.floor((Date.now() - foundedMs) / 86400000) + 1);
const walineServerUrl =
  import.meta.env.PUBLIC_WALINE_SERVER_URL || "https://waline-comment-smoky.vercel.app";

const murmurBriefs = murmurs.map((m) => ({
  date: m.date,
  excerpt: m.rawText,
}));

const searchIndex = {
  posts: renderedPosts.map((p) => ({
    slug: p.slug,
    title: p.title,
    description: p.description,
    published: p.published,
    category: p.category,
    tags: p.tags,
    text: p.plainText,
  })),
  murmurs: murmurs.map((m) => ({
    date: m.date,
    text: m.rawText,
  })),
};

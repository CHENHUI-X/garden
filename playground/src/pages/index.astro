      <div class="hanger" data-action="murmur">
        <button type="button" class="hanger-btn" aria-label="展开碎碎念便签墙">
          <svg class="clothespin" viewBox="0 0 24 44" aria-hidden="true">
            <rect x="6" y="2" width="12" height="39" rx="2.5" fill="#C9A276" stroke="#6E4E2E" stroke-width="1.2" />
            <line x1="12" y1="3" x2="12" y2="39" stroke="#8C6740" stroke-width="1" opacity="0.65" />
            <rect x="4.5" y="16" width="15" height="5" rx="1.2" fill="#8C847B" stroke="#4D4740" stroke-width="1" />
          </svg>

          <div class="hanger-inner">
            <div class="art-memo-stack">
              <div class="memo-slip memo-back-2" aria-hidden="true"></div>
              <div class="memo-slip memo-back-1" aria-hidden="true"></div>
              <div class="memo-slip memo-front">
                <div class="card-sheen" aria-hidden="true"></div>
                <div class="memo-header">
                  <span class="memo-date">{latestMurmur.date}</span>
                  <span class="memo-count-pill">{murmurs.length} 条</span>
                </div>
                <p class="memo-body">{latestMurmur.rawText}</p>
                <div class="memo-footer">
                  <span>{latestMurmur.images.length ? `碎碎念 · ${latestMurmur.images.length} 图` : "碎碎念"}</span>
                  <span>查看 →</span>
                </div>
              </div>
            </div>
            <div class="hang-tag lbl">
              <span class="hang-num">03</span>
              <span>碎碎念 / MURMUR</span>
            </div>
          </div>
        </button>
      </div>

      <!-- 04. Vintage Airmail Postcard (Friends) -->
      <div class="hanger" data-action="friends">
        <button type="button" class="hanger-btn" aria-label="打开朋友们明信片盒">
          <svg class="clothespin" viewBox="0 0 24 44" aria-hidden="true">
            <rect x="6" y="2" width="12" height="39" rx="2.5" fill="#C9A276" stroke="#6E4E2E" stroke-width="1.2" />
            <line x1="12" y1="3" x2="12" y2="39" stroke="#8C6740" stroke-width="1" opacity="0.65" />
            <rect x="4.5" y="16" width="15" height="5" rx="1.2" fill="#8C847B" stroke="#4D4740" stroke-width="1" />
          </svg>

          <div class="hanger-inner">
            <div class="art-postcard">
              <div class="card-sheen" aria-hidden="true"></div>
              <div class="postcard-top">
                <span class="postcard-airmail">PAR AVION</span>
                <div class="postcard-stamp" aria-hidden="true">
                  <span>BJ</span>
                  <span>2026</span>
                </div>
              </div>
              <div class="postcard-mid">
                <h3 class="postcard-title">朋友们</h3>
                <p class="postcard-lines">
                  {friends.length ? `${friends[0].name} 等 ${friends.length} 位朋友` : "暂无友链，欢迎交换"}
                </p>
              </div>
              <div class="postcard-postmark">
                <span>BEIJING</span>
                <span>POSTCARD →</span>
              </div>
            </div>
            <div class="hang-tag lbl">
              <span class="hang-num">04</span>
              <span>朋友们 / FRIENDS</span>
            </div>
          </div>
        </button>
      </div>

      <!-- 05. Vintage LP Vinyl Record Sleeve (NetEase Music Player) -->
      <div class="hanger" data-action="vinyl">
        <div class="hanger-btn" role="button" tabindex="0" aria-label="打开网易云黑胶留声机">
          <svg class="clothespin" viewBox="0 0 26 44" aria-hidden="true">
            <rect x="8.5" y="4" width="12" height="38" rx="2.5" fill="rgba(24,16,10,0.18)" />
            <rect x="7" y="2" width="12" height="39" rx="2.5" fill="#C9A276" stroke="#6E4E2E" stroke-width="1.2" />
            <line x1="13" y1="3" x2="13" y2="39" stroke="#8C6740" stroke-width="1" opacity="0.65" />
            <rect x="5.5" y="16" width="15" height="5" rx="1.2" fill="#8C847B" stroke="#4D4740" stroke-width="1" />
            <circle cx="13" cy="18.5" r="1.4" fill="#3B352F" />
          </svg>

          <div class="hanger-inner">
            <div class="art-vinyl-hang" id="hang-vinyl-card">
              <!-- Peeking spinning grooved black vinyl disc -->
              <div class="hang-vinyl-disc-wrap" aria-hidden="true">
                <div class="hang-vinyl-disc">
                  <div class="hang-vinyl-grooves"></div>
                  <div class="hang-vinyl-label">
                    <img src={vinylSleeveImg.src} alt="" width="64" height="64" draggable="false" />
                  </div>
                  <span class="hang-vinyl-pin"></span>
                </div>
              </div>

              <!-- Square Laminated LP Record Sleeve (keeps curated default art on homepage) -->
              <div class="hang-vinyl-sleeve">
                <div class="card-sheen" aria-hidden="true"></div>
                <img class="hang-sleeve-cover" src={vinylSleeveImg.src} alt="网易云歌单黑胶封套" width="180" height="180" draggable="false" />
                <div class="hang-sleeve-crease" aria-hidden="true"></div>
                <div class="hang-sleeve-scrim" aria-hidden="true"></div>

                <div class="hang-sleeve-top">
                  <span class="hang-lp-pill lbl">LP · 网易云</span>
                  <span class="hang-vu-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                </div>

                <div class="hang-sleeve-bottom">
                  <div class="hang-sleeve-meta">
                    <span class="hang-sleeve-title" data-mini-title>{MUSIC_CONFIG.playlistTitle}</span>
                    <span class="hang-sleeve-sub" data-mini-sub>点击播放</span>
                  </div>
                  <button
                    type="button"
                    class="hang-vinyl-play"
                    data-mini-toggle
                    aria-label="播放或暂停网易云歌单"
                    title="直接播放 / 暂停"
                  >
                    <svg class="play-morph-svg" width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                      <path data-morph-a d="M4.2 2.6 L8.9 5.35 L8.9 10.65 L4.2 13.4 Z" />
                      <path data-morph-b d="M8.6 5.2 L13.4 8 L13.4 8 L8.6 10.8 Z" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <div class="hang-tag lbl">
              <span class="hang-num">05</span>
              <span>留声机 / VINYL</span>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Bottom Editorial Strip -->
    <footer class="bottom-strip">
      <div class="motto-block">
        <div class="motto-eyebrow lbl">EPIGRAPH · 题记</div>
        <p class="motto-text">「人无法同时拥有青春和对青春的感受」</p>
      </div>

      <div id="gesture-hint" class="gesture-hint" aria-live="polite">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M2 8c2.5-3 4.5 3 6 0s3.5 3 6 0" stroke-linecap="round" />
        </svg>
        <span>拨动晾衣绳 · 点击物件展开 · 快捷键 1-5</span>
      </div>

      <nav class="quick-nav" aria-label="快捷入口">
        <button type="button" class="quick-pill" data-open-modal="about"><span class="q-idx">01</span> 关于</button>
        <button type="button" class="quick-pill primary" data-open-modal="book"><span class="q-idx">02</span> 翻开书册</button>
        <button type="button" class="quick-pill" data-open-modal="murmur"><span class="q-idx">03</span> 碎碎念</button>
        <button type="button" class="quick-pill" data-open-modal="friends"><span class="q-idx">04</span> 友链</button>
        <button type="button" class="quick-pill" data-open-modal="vinyl"><span class="q-idx">05</span> 留声机</button>
      </nav>
    </footer>

    <!-- Custom Magnetic Cursor (Desktop Fine Pointer Only) -->
    <div id="studio-cursor" class="studio-cursor" aria-hidden="true">
      <div class="cursor-ring"></div>
      <div class="cursor-dot"></div>
      <div class="cursor-label">
        <span data-cursor-top>OPEN</span>
        <span data-cursor-sub>展开</span>
      </div>
    </div>

    <!-- ======================================================================
         BUILD-TIME RENDERED POST TEMPLATES (Fed into the 3D Book Paginator)
         ====================================================================== -->
    {
      renderedPosts.map((post) => (
        <template
          class="book-source-post"
          data-slug={post.slug}
          data-title={post.title}
          data-description={post.description}
          data-published={post.published}
          data-category={post.category}
          data-tags={post.tags.join(",")}
          data-chars={String(post.charCount)}
        >
          <post.Content />
        </template>
      ))
    }

    <script id="studio-murmur-data" type="application/json" set:html={JSON.stringify(murmurBriefs)} />
    <script id="studio-search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />

    <!-- Full-Screen 3D Book Reader & Paper Sheet Modals -->
    <BookReaderModal walineServerUrl={walineServerUrl} />
    <StudioModals
      avatarSrc={avatarImg.src}
      postCount={renderedPosts.length}
      totalChars={totalChars}
      murmurs={murmurs}
      friends={friends}
      daysOnline={daysOnline}
    />
    <VinylPlayerModal avatarSrc={avatarImg.src} />

    <!-- Bundled Studio Engine -->
    <script>
      import "../scripts/studio-main";
    </script>
  </body>
</html>

---

---

<div class="quote-card" id="quote-card">
  <blockquote id="quote-text">加载中...</blockquote>
  <div class="quote-footer">
    <span id="quote-source"></span>
    <button id="quote-refresh" title="换一句">⟳</button>
  </div>
</div>

<script>
  const fetchQuote = () => {
    const textEl = document.getElementById("quote-text");
    const sourceEl = document.getElementById("quote-source");
    textEl.textContent = "加载中...";
    sourceEl.textContent = "";

    fetch("https://v1.hitokoto.cn/?c=k&c=d&c=i&c=h")
      .then((res) => res.json())
      .then((data) => {
        textEl.textContent = data.hitokoto;
        let src = "";
        if (data.from_who && data.from)
          src = data.from_who + "《" + data.from + "》";
        else if (data.from) src = "《" + data.from + "》";
        else if (data.from_who) src = data.from_who;
        sourceEl.textContent = src ? "——" + src : "";
      })
      .catch(() => {
        textEl.textContent = "人无法同时拥有青春和对青春的感受";
      });
  };

  document.addEventListener("DOMContentLoaded", fetchQuote);
  document.addEventListener("astro:page-load", fetchQuote);
  document
    .getElementById("quote-refresh")
    ?.addEventListener("click", fetchQuote);
</script>

<style>
  .quote-card {
    margin: 0;
  }
  .quote-card blockquote {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--charm-highlight-color);
    background: var(--charm-contrast-color-2);
    border-radius: 0 0.4rem 0.4rem 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--charm-text-color);
    opacity: 0.85;
    font-style: italic;
    min-height: 2.5rem;
  }
  .quote-card blockquote::before,
  .quote-card blockquote::after {
    content: none;
  }
  .quote-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.35rem;
    font-size: 0.72rem;
    opacity: 0.5;
    color: var(--charm-text-color);
  }
  #quote-refresh {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    color: inherit;
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    transition: opacity 0.2s;
    opacity: 0.6;
    line-height: 1;
  }
  #quote-refresh:hover {
    opacity: 1;
    background: var(--charm-contrast-color-2);
  }
</style>

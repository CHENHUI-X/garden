---
// 友链申请须知组件
---

<div class="apply-info">
  <ul class="apply-list">
    <li>
      <span class="apply-icon">✓</span>
      <span>博客正常访问</span>
    </li>
    <li>
      <span class="apply-icon">✓</span>
      <span>内容原创为主</span>
    </li>
    <li>
      <span class="apply-icon">✓</span>
      <span>已互加友链</span>
    </li>
  </ul>
  <a href="mailto:chenhui2422.xu@gmail.com" class="apply-btn">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
      <polyline points="22,6 12,13 2,6"/>
    </svg>
    <span>申请友链</span>
  </a>
</div>

<style>
  .apply-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .apply-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .apply-list li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    opacity: 0.75;
  }
  .apply-icon {
    color: var(--charm-highlight-color);
    font-size: 0.75rem;
    font-weight: bold;
  }
  .apply-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.5rem;
    background: var(--charm-contrast-color-2);
    color: var(--charm-text-color);
    text-decoration: none;
    border-radius: 0.4rem;
    font-size: 0.8rem;
    transition: background 0.2s, color 0.2s;
  }
  .apply-btn:hover {
    background: var(--charm-highlight-color);
    color: white;
  }
  .apply-btn svg {
    flex-shrink: 0;
  }
</style>

---
import { getCollection } from "astro:content";

const allPosts = await getCollection(
  "posts",
  ({ data }) =>
    data && !data.hidden && (import.meta.env.PROD ? data.draft !== true : true),
);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  post.data.tags?.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1));
}

const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
const tagsJson = JSON.stringify(sortedTags);
---

<div class="tag-cloud-wrapper">
  <canvas id="wordcloud-canvas"></canvas>
  <div id="tagcloud-fallback" class="fallback">
    {sortedTags.map(([tag]) => (
      <a href={`/tags/${tag}`} class="tag-item">{tag}</a>
    ))}
  </div>
</div>

<script define:vars={{ tagsJson }}>
const tags = JSON.parse(tagsJson);

function loadWordCloud() {
  const canvas = document.getElementById('wordcloud-canvas');
  const fallback = document.getElementById('tagcloud-fallback');
  if (!canvas) return;

  // 检测是否暗色模式
  const isDark = document.documentElement.classList.contains('charm') && 
                 document.documentElement.classList.contains('dark');
  
  // 准备词云数据 [word, weight]
  const words = tags.map(([tag, count]) => [tag, count * 10]);
  
  // Canvas 尺寸
  const width = canvas.parentElement?.offsetWidth || 200;
  const height = Math.max(120, Math.min(180, words.length * 8));
  canvas.width = width;
  canvas.height = height;
  canvas.style.width = width + 'px';
  canvas.style.height = height + 'px';

  // 颜色函数
  const colors = isDark 
    ? ['#60a5fa', '#a78bfa', '#f472b6', '#34d399', '#fbbf24', '#fb923c']
    : ['#3b82f6', '#8b5cf6', '#ec4899', '#10b981', '#f59e0b', '#f97316'];
  
  function randomColor() {
    return colors[Math.floor(Math.random() * colors.length)];
  }

  // 加载 wordcloud2.js
  if (typeof WordCloud === 'undefined') {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/wordcloud@1.2.2/src/wordcloud2.min.js';
    script.onload = () => renderWordCloud();
    document.head.appendChild(script);
  } else {
    renderWordCloud();
  }

  function renderWordCloud() {
    if (typeof WordCloud === 'undefined') {
      fallback.style.display = 'flex';
      return;
    }
    
    fallback.style.display = 'none';
    
    WordCloud(canvas, {
      list: words,
      gridSize: 6,
      weightFactor: 2.5,
      fontFamily: 'system-ui, sans-serif',
      color: () => randomColor(),
      rotateRatio: 0.3,
      rotationSteps: 2,
      backgroundColor: 'transparent',
      drawOutOfBound: false,
      shrinkToFit: true,
      hover: function(item, dimension, event) {
        if (item) {
          canvas.style.cursor = 'pointer';
        } else {
          canvas.style.cursor = 'default';
        }
      },
      click: function(item) {
        if (item) {
          const tag = item[0];
          window.location.href = '/tags/' + encodeURIComponent(tag);
        }
      }
    });
  }
}

// 初始化
document.addEventListener('DOMContentLoaded', loadWordCloud);
document.addEventListener('astro:page-load', loadWordCloud);

// 监听暗色模式变化
const observer = new MutationObserver((mutations) => {
  mutations.forEach((mutation) => {
    if (mutation.attributeName === 'class') {
      loadWordCloud();
    }
  });
});

document.addEventListener('DOMContentLoaded', () => {
  observer.observe(document.documentElement, { attributes: true });
});
document.addEventListener('astro:page-load', () => {
  observer.observe(document.documentElement, { attributes: true });
});
</script>

<style>
  .tag-cloud-wrapper {
    position: relative;
    min-height: 100px;
  }
  
  #wordcloud-canvas {
    display: block;
    margin: 0 auto;
  }
  
  .fallback {
    display: none;
    flex-wrap: wrap;
    gap: 0.3rem 0.4rem;
    align-items: center;
  }
  
  .tag-item {
    text-decoration: none;
    color: var(--charm-text-color);
    opacity: 0.75;
    transition: all 0.2s ease;
    padding: 0.12rem 0.35rem;
    border-radius: 0.3rem;
    font-size: 0.75rem;
    line-height: 1.3;
  }
  
  .tag-item:hover {
    opacity: 1;
    color: var(--charm-highlight-color);
    background: rgba(255, 255, 255, 0.08);
  }
</style>

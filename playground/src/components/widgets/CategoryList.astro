---
import { getCollection } from "astro:content";

const allPosts = await getCollection(
  "posts",
  ({ data }) =>
    !data.hidden && (import.meta.env.PROD ? data.draft !== true : true),
);

const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
  if (post.data.category) {
    categoryCounts.set(
      post.data.category,
      (categoryCounts.get(post.data.category) ?? 0) + 1,
    );
  }
}

const sortedCategories = [...categoryCounts.entries()].sort(
  (a, b) => b[1] - a[1],
);
---

<div class="category-list">
  {
    sortedCategories.length > 0 ? (
      sortedCategories.map(([cat, count]) => (
        <a href={`/categories/${cat}`} class="category-item">
          <span class="category-name">{cat}</span>
          <span class="category-count">{count}</span>
        </a>
      ))
    ) : (
      <span class="empty">暂无分类</span>
    )
  }
</div>

<style>
  .category-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.3rem 0.5rem;
    border-radius: 0.35rem;
    text-decoration: none;
    color: var(--charm-text-color);
    transition: all 0.2s ease;
  }
  .category-item:hover {
    background: var(--charm-contrast-color-2);
    color: var(--charm-highlight-color);
  }
  .category-name {
    font-size: 0.88rem;
  }
  .category-count {
    font-size: 0.75rem;
    opacity: 0.6;
    background: var(--charm-contrast-color-2);
    padding: 0.05rem 0.45rem;
    border-radius: 0.75rem;
    min-width: 1.4rem;
    text-align: center;
  }
  .category-item:hover .category-count {
    background: var(--charm-highlight-color-1);
    color: var(--charm-highlight-color);
  }
  .empty {
    font-size: 0.85rem;
    opacity: 0.5;
  }
</style>

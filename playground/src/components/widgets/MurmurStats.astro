---
export interface Props {
  dates: string[];
}

const { dates } = Astro.props;

const totalMurmurs = dates.length;

const sortedDates = [...dates].sort();
const earliest = sortedDates[0] ?? "";
const latest = sortedDates[sortedDates.length - 1] ?? "";

const daySpan =
  earliest && latest
    ? Math.floor(
        (new Date(latest).valueOf() - new Date(earliest).valueOf()) /
          (1000 * 60 * 60 * 24),
      ) + 1
    : 0;

const stats = [
  { label: "说说", value: totalMurmurs },
  { label: "跨越", value: `${daySpan} 天` },
];
---

<div class="stats-grid">
  {
    stats.map((s) => (
      <div class="stat-card">
        <span class="stat-value">{s.value}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))
  }
</div>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.6rem 0.4rem;
    border-radius: 0.5rem;
    background: var(--charm-contrast-color-2);
    transition: background 0.2s ease;
  }
  .stat-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--charm-highlight-color);
  }
  .stat-label {
    font-size: 0.75rem;
    opacity: 0.7;
    margin-top: 0.15rem;
  }
</style>

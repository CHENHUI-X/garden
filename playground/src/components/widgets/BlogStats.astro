---
import { getCollection } from "astro:content";

const allPosts = await getCollection(
  "posts",
  ({ data }) =>
    !data.hidden && (import.meta.env.PROD ? data.draft !== true : true),
);

const totalPosts = allPosts.length;

const allTags = new Set<string>();
const allCategories = new Set<string>();
let earliestDate =
  allPosts.length > 0 ? allPosts[0].data.published : new Date();

for (const post of allPosts) {
  post.data.tags?.forEach((t) => allTags.add(t));
  if (post.data.category) allCategories.add(post.data.category);
  if (post.data.published < earliestDate) earliestDate = post.data.published;
}

const daysSinceFirst = Math.floor(
  (Date.now() - earliestDate.valueOf()) / (1000 * 60 * 60 * 24),
);

const stats = [
  { label: "文章", value: totalPosts },
  { label: "标签", value: allTags.size },
  { label: "分类", value: allCategories.size },
  { label: "已运行", value: `${daysSinceFirst} 天` },
];
---

<div class="stats-grid">
  {
    stats.map((s) => (
      <div class="stat-card">
        <span class="stat-value">{s.value}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))
  }
</div>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
  }
  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.3rem 0.2rem;
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.04);
    transition: background 0.2s ease;
  }
  .stat-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--charm-highlight-color);
  }
  .stat-label {
    font-size: 0.68rem;
    opacity: 0.6;
    margin-top: 0.08rem;
  }
</style>

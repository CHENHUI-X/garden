}

#waline-container .wl-reaction-title::before,
#waline-container .wl-reaction-title::after {
  content: "";
  display: inline-block;
  width: clamp(12px, 4vw, 24px);
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(128, 128, 128, 0.25), transparent);

  padding: 0.5rem 0;
  width: 100% !important;
  max-width: 100% !important;
  overflow: visible !important;
}

#waline-container .wl-reaction-title {
  font-size: clamp(0.85rem, 2.5vw, 0.95rem) !important;
  font-weight: 500 !important;

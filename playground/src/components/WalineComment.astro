---
// 文章底部评论组件（懒加载 + 重试）
const { postEntry } = Astro.props;
const serverURL = import.meta.env.PUBLIC_WALINE_SERVER_URL;
const slug = postEntry.slug;
---

<div id="waline-container" data-serverurl={serverURL} data-path={'/' + slug}>
  <div class="waline-loading">
    <span class="loading-spinner"></span>
    <span>评论加载中...</span>
  </div>
</div>

<script>
const initWaline = async () => {
  const container = document.getElementById("waline-container");
  if (!container || container.dataset.loaded) return;
  
  const serverURL = container.dataset.serverurl;
  const path = container.dataset.path;
  
  // 清除 loading 占位符
  const loading = container.querySelector(".waline-loading");
  if (loading) loading.remove();
  
  // 先测试服务器连通性（3s 超时）
  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 3000);
    await fetch(serverURL + "/api/comment?path=" + encodeURIComponent(path), {
      method: "HEAD",
      mode: "no-cors",
      signal: controller.signal,
    });
    clearTimeout(timeout);
  } catch (e) {
    // 连通性测试失败，仍然尝试加载（可能是 CORS 限制导致的假失败）
    console.warn("[Waline] 服务器连通性测试失败，仍尝试加载:", e);
  }
  
  try {
    // 动态导入 Waline (ESM)，10s 超时
    const walineModule = await Promise.race([
      import("https://unpkg.com/@waline/client@3/dist/waline.js"),
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("Waline 加载超时")), 10000)
      ),
    ]);
    
    walineModule.init({
      el: "#waline-container",
      serverURL: serverURL,
      path: path,
      lang: "zh-CN",
      reaction: true,
      pageview: true,
      dark: "html.charm.dark",
      requiredMeta: ["nick", "mail"],
    });
    container.dataset.loaded = "true";
  } catch (e) {
    console.error("[Waline] 加载失败:", e);
    container.innerHTML = `
      <div class="waline-error">
        <p>评论加载失败</p>
        <p class="waline-error-hint">可能是网络原因，请稍后重试</p>
        <button class="waline-retry-btn" onclick="location.reload()">刷新页面</button>
      </div>
    `;
  }
};

// 懒加载：评论区进入视口时才加载
const setupLazyLoad = () => {
  const container = document.getElementById("waline-container");
  if (!container || container.dataset.loaded) return;
  
  // 检查是否支持 IntersectionObserver
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            observer.disconnect();
            initWaline();
          }
        });
      },
      { rootMargin: "200px" } // 提前 200px 开始加载
    );
    observer.observe(container);
  } else {
    // 降级：直接加载
    initWaline();
  }
};

// 页面加载后设置懒加载
if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", setupLazyLoad);
} else {
  setupLazyLoad();
}

// Astro View Transitions 支持
document.addEventListener("astro:page-load", setupLazyLoad);
</script>

<style>
#waline-container {
  margin-top: 2rem;
  min-height: 100px;
}

.waline-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 2rem;
  opacity: 0.5;
  font-size: 0.9rem;
}

.loading-spinner {
  width: 1rem;
  height: 1rem;
  border: 2px solid var(--charm-border, rgba(128, 128, 128, 0.3));
  border-top-color: var(--charm-highlight-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.waline-error {
  text-align: center;
  padding: 2rem;
  opacity: 0.7;
}

.waline-error p {
  margin: 0.3rem 0;
}

.waline-error-hint {
  font-size: 0.8rem;
  opacity: 0.6;
}

.waline-retry-btn {
  margin-top: 1rem;
  padding: 0.5rem 1.5rem;
  border: 1px solid var(--charm-border, rgba(128, 128, 128, 0.3));
  border-radius: 0.5rem;
  background: transparent;
  color: var(--charm-text-color);
  cursor: pointer;
  font-size: 0.85rem;
  transition: all 0.2s;
}

.waline-retry-btn:hover {
  border-color: var(--charm-highlight-color);
  color: var(--charm-highlight-color);
}
</style>

---
// 文章底部评论组件
const { postEntry } = Astro.props;
const serverURL = import.meta.env.PUBLIC_WALINE_SERVER_URL;
const slug = postEntry.slug;
---

<div id="waline-container" data-serverurl={serverURL} data-path={'/' + slug}></div>

<script>
async function initWaline() {
  const container = document.getElementById("waline-container");
  if (!container || container.dataset.loaded) return;
  
  const serverURL = container.dataset.serverurl;
  const path = container.dataset.path;
  
  // 动态导入 Waline (ESM)
  const { init } = await import("https://unpkg.com/@waline/client@3/dist/waline.js");
  
  init({
    el: "#waline-container",
    serverURL: serverURL,
    path: path,
    lang: "zh-CN",
    reaction: true,
    pageview: true,
    dark: "html.charm.dark",
    requiredMeta: ["nick", "mail"],
  });
  container.dataset.loaded = "true";
}

// 页面加载后立即初始化
if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initWaline);
} else {
  initWaline();
}

// Astro View Transitions 支持
document.addEventListener("astro:page-load", initWaline);
</script>

<style>
#waline-container {
  margin-top: 2rem;
}
</style>

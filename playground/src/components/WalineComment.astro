  --waline-border-color: rgba(128, 128, 128, 0.15);
  --waline-bg-color: rgba(255, 255, 255, 0.45);
  --waline-bg-color-light: rgba(255, 255, 255, 0.25);
  --waline-bg-color-hover: rgba(224, 100, 88, 0.08);
  --waline-box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
  --waline-avatar-radius: 50%;
}

html.charm.dark #waline-container {
  --waline-theme-color: var(--charm-highlight-color, #e06458);
  --waline-active-color: var(--charm-highlight-color, #e06458);
  --waline-color: var(--charm-text-color, #e2e8f0);
  --waline-border-color: rgba(255, 255, 255, 0.1);
  --waline-bg-color: rgba(30, 32, 40, 0.45);
  --waline-bg-color-light: rgba(255, 255, 255, 0.05);
  --waline-bg-color-hover: rgba(224, 100, 88, 0.15);
  --waline-box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

/* 1. 表情反应栏 (Reaction Bar) - 彻底清除横向滚动条，实现等比自动缩放 */
#waline-container .wl-reaction {

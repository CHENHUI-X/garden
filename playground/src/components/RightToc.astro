---
// 定义类型
interface NestedHeading {
  slug: string;
  text: string;
  subheadings?: NestedHeading[];
  nestedDepth: number;
  absoluteDepth?: number;
}

export interface Props {
  headings: NestedHeading[];
  title?: string;
}

const { headings, title = "目录" } = Astro.props;

// 将嵌套标题扁平化为带层级信息的列表
function flattenHeadings(
  headings: NestedHeading[],
  level: number = 0,
): { slug: string; text: string; level: number }[] {
  const result: { slug: string; text: string; level: number }[] = [];
  for (const h of headings) {
    result.push({ slug: h.slug, text: h.text, level });
    if (h.subheadings && h.subheadings.length > 0) {
      result.push(...flattenHeadings(h.subheadings, level + 1));
    }
  }
  return result;
}

const flatHeadings = flattenHeadings(headings);
---

{
  flatHeadings.length > 0 && (
    <div class="right-toc-wrapper">
      <div class="toc-title">{title}</div>
      <ul class="toc-list">
        {flatHeadings.map((item) => (
          <li
            class="toc-heading"
            data-toc-slug={item.slug}
            style={`padding-left: ${item.level * 0.75}rem;`}
          >
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .right-toc-wrapper {
    position: sticky;
    top: 2rem;
    width: 12em;
    flex-shrink: 0;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    margin-left: 1rem;
    padding-right: 1.5rem;
  }

  .toc-title {
    font-size: 1.1rem;
    font-weight: bold;
    margin-bottom: 0.75rem;
    color: var(--charm-text-color);
  }

  .toc-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .toc-heading {
    margin: 0;
  }

  .toc-heading::marker {
    content: none;
  }

  .toc-heading a {
    display: block;
    padding: 0.35rem 0.5rem;
    border-left: 2px solid transparent;
    transition: all 0.2s ease;
    font-size: 0.85rem;
    color: var(--charm-text-color);
    opacity: 0.7;
    text-decoration: none;
    line-height: 1.4;
  }

  .toc-heading a:hover {
    opacity: 1;
    border-left-color: var(--charm-highlight-color);
  }

  .toc-heading.toc-heading-in-view a {
    opacity: 1;
    border-left-color: var(--charm-highlight-color);
    background: linear-gradient(
      90deg,
      var(--charm-highlight-color-1),
      transparent
    );
  }

  /* 响应式：中等屏幕隐藏右侧目录 */
  @media (max-width: 64rem) {
    .right-toc-wrapper {
      display: none;
    }
  }
</style>

<script>
  const initTocHighlight = () => {
    const articleHeadings = document.querySelectorAll(
      "article[data-pagefind-body] h2, article[data-pagefind-body] h3, article[data-pagefind-body] h4, article[data-pagefind-body] h5, article[data-pagefind-body] h6",
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slug = entry.target.id;
          const tocItem = document.querySelector(
            `.right-toc-wrapper .toc-heading[data-toc-slug="${slug}"]`,
          );
          if (tocItem) {
            tocItem.classList.toggle(
              "toc-heading-in-view",
              entry.isIntersecting,
            );
          }
        });
      },
      { threshold: 0.1, rootMargin: "-20px 0px -80% 0px" },
    );

    articleHeadings.forEach((heading) => observer.observe(heading));
  };

  document.addEventListener("DOMContentLoaded", initTocHighlight);
  document.addEventListener("astro:page-load", initTocHighlight);
</script>

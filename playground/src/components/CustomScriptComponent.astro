---
// This component is injected into the end of <head>
import { getCollection } from "astro:content";
const posts = await getCollection("posts", ({ data }) => data && !data.draft);
const allTags = posts.flatMap((p) => p.data.tags ?? []);
const uniqueTagCount = new Set(allTags).size;
const totalChars = posts.reduce((sum, p) => {
  const cleaned = (p.body ?? "")
    .replace(/^---[\s\S]*?---/, "")
    .replace(/[#*`>\[\]!]/g, "");
  return sum + cleaned.length;
}, 0);
const postCount = posts.length;
const FOUNDED = "2026-05-01";
---

<style is:inline>
  /* ========== 布局宽度优化 ========== */
  /* 使用更高优先级的选择器覆盖 Astro scoped CSS */

  /* 1. 正文内容区宽度: 64rem (1024px) */
  html.charm body main .content-wrapper.content-wrapper {
    max-width: 64rem !important;
  }
  /* 2. 侧边栏宽度: 15-18em 弹性 */
  html.charm body main .side.side {
    width: clamp(15em, 16em, 18em) !important;
    flex-shrink: 0;
  }
  /* 3. 主区域间距 + 边距: 侧边栏离正文更近，布局整体居中 */
  html.charm body main {
    gap: clamp(0.5rem, 1vw, 1.5rem) !important;
    margin: 0 clamp(2rem, 4vw, 8rem) !important;
  }
  /* 4. 响应式优化 */
  @media (min-width: 90rem) {
    html.charm body main {
      margin: 0 clamp(1.5rem, 5vw, 8rem) !important;
    }
  }
  @media (max-width: 64rem) {
    html.charm body main .content-wrapper.content-wrapper {
      max-width: calc(100vw - 22rem) !important;
    }
  }
  @media (max-width: 52rem) {
    html.charm body main .content-wrapper.content-wrapper {
      max-width: calc(100vw - 18rem) !important;
    }
    html.charm body main .side.side {
      width: 14em !important;
    }
  }
</style>

<style is:global>
  /* 背景图容器 */
  #anime-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  #anime-bg img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  @media (orientation: landscape) and (min-width: 52rem) {
    #anime-bg img {
      object-position: right center;
    }
  }

  @media (orientation: portrait) {
    #anime-bg img {
      object-position: center top;
    }
  }

  #anime-bg img.visible {
    opacity: 0.16;
  }
  html.charm.dark #anime-bg img.visible {
    opacity: 0.18;
  }
  html.charm body {
    background-color: transparent !important;
  }

  /* ========== 顶部流动阅读进度条 ========== */
  #reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2.5px;
    width: 0%;
    background: linear-gradient(90deg, var(--charm-highlight-color), #ff8e72, #e06458);
    z-index: 99999;
    pointer-events: none;
    transition: width 0.08s ease-out;
    box-shadow: 0 0 8px rgba(224, 100, 88, 0.4);
  }

  /* ========== 返回顶部按钮 (毛玻璃与微动效) ========== */
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--charm-highlight-color);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.3s,
      background 0.25s,
      box-shadow 0.25s,
      color 0.25s,
      border-color 0.25s;
    z-index: 1000;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  html.charm.dark .back-to-top {
    background: rgba(30, 32, 40, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .back-to-top:hover {
    transform: translateY(-4px) scale(1.08);
    background: var(--charm-highlight-color);
    color: #ffffff;
    border-color: var(--charm-highlight-color);
    box-shadow: 0 8px 24px rgba(224, 100, 88, 0.35);
  }

  .back-to-top:active {
    transform: translateY(-1px) scale(0.96);
  }

  @media (max-width: 42rem) {
    .back-to-top {
      bottom: 1.25rem;
      right: 1.25rem;
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  /* ========== 动效与微交互 ========== */

  /* 1. 主题切换按钮动效优化 */
  #theme-toggle {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease !important;
  }
  #theme-toggle:hover {
    transform: rotate(25deg) scale(1.15) !important;
  }
  #theme-toggle:active {
    transform: rotate(180deg) scale(0.9) !important;
  }

  /* 2. 进入微动效 */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .post-list .item-container,
  .widget-section {
    animation: fadeInUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .post-list .item-container:nth-child(1) { animation-delay: 0.04s; }
  .post-list .item-container:nth-child(2) { animation-delay: 0.08s; }
  .post-list .item-container:nth-child(3) { animation-delay: 0.12s; }
  .post-list .item-container:nth-child(4) { animation-delay: 0.16s; }

  /* 3. 正文超链接平滑下划线动效 */
  article a:not(.anchor):not(.license-link) {
    position: relative;
    text-decoration: none !important;
    color: var(--charm-highlight-color) !important;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  article a:not(.anchor):not(.license-link)::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--charm-highlight-color);
    transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  article a:not(.anchor):not(.license-link):hover::after {
    width: 100%;
  }

  /* 4. 引用块优雅重绘 */
  article blockquote {
    position: relative;
    margin: 1.5rem 0 !important;
    padding: 1rem 1.25rem 1rem 2.8rem !important;
    font-size: 1rem !important;
    font-style: normal !important;
    line-height: 1.8 !important;
    background: rgba(var(--charm-background-rgb, 255, 255, 255), 0.4) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(128, 128, 128, 0.1) !important;
    border-left: 4px solid var(--charm-highlight-color) !important;
    border-radius: 0.6rem !important;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
  }
  html.charm.dark article blockquote {
    background: rgba(30, 32, 40, 0.45) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    border-left: 4px solid var(--charm-highlight-color) !important;
  }
  article blockquote::before {
    content: "“" !important;
    position: absolute !important;
    top: 0.35rem !important;
    left: 0.75rem !important;
    font-family: Georgia, serif !important;
    font-size: 2.8rem !important;
    line-height: 1 !important;
    color: var(--charm-highlight-color) !important;
    opacity: 0.35 !important;
  }

  /* 5. macOS 风格代码块 */
  .code-block {
    position: relative;
    border-radius: 0.75rem !important;
    overflow: hidden;
    border: 1px solid rgba(128, 128, 128, 0.18);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    margin: 1.5rem 0 !important;
  }
  html.charm.dark .code-block {
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
  }
  .code-block .code-header {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.85rem !important;
    background: rgba(128, 128, 128, 0.08) !important;
    border-bottom: 1px solid rgba(128, 128, 128, 0.1);
  }
  .code-block .code-header::before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f56;
    box-shadow: 15px 0 0 #ffbd2e, 30px 0 0 #27c93f;
    margin-right: 38px;
    flex-shrink: 0;
  }

  /* 6. 中文排版优化 */
  article {
    line-height: 1.85 !important;
    letter-spacing: 0.015em;
  }
  article p {
    margin-bottom: 1.35rem !important;
  }
  article h1, article h2, article h3 {
    letter-spacing: 0.01em;
    scroll-margin-top: 5rem;
  }
  article h2 {
    margin-top: 2rem !important;
    margin-bottom: 0.85rem !important;
  }
  article h3 {
    margin-top: 1.6rem !important;
    margin-bottom: 0.75rem !important;
  }
  article hr {
    margin: 2.25rem 0 !important;
    border: none !important;
    height: 1px !important;
    background: linear-gradient(90deg, transparent, var(--charm-border, rgba(128, 128, 128, 0.2)), transparent) !important;
  }

  /* ========== 侧边栏整体排版优化 ========== */

  /* 1. 图标列与 IUHNEHC 之间 */
  html.charm .side .center {
    gap: 1rem !important;
  }

  /* 2. 去掉 <ul> 默认 padding, 宽度留少许余白 */
  html.charm .side-home {
    max-width: 95% !important;
    padding-left: 0 !important;
  }

  /* 3. 大标题保持紧凑，副标题与其右侧对齐 */
  html.charm .side-home-title {
    display: inline !important;
  }
  html.charm .side-home-bio {
    margin: 1rem 0 !important;
  }

  /* 4. footer 内边距缩小 */
  html.charm .side .footer {
    padding: 2rem 0 !important;
  }

  /* 5. 主题切换按钮与其他按钮对齐 */
  html.charm .side .footer #theme-toggle {
    margin-right: 0 !important;
    scale: 1 !important;
  }
  html.charm .side .footer #theme-toggle .icon {
    width: 1.5rem !important;
    height: 1.5rem !important;
  }
</style>

<script define:vars={{ postCount, uniqueTagCount, totalChars, FOUNDED, WALINE_SERVER: import.meta.env.PUBLIC_WALINE_SERVER_URL }}>
  window.__siteStats = { postCount, uniqueTagCount, totalChars, FOUNDED };
  window.__walineServerURL = WALINE_SERVER;
</script>

<script>
  function renderStats() {
    const el = document.getElementById("site-stats-dynamic");
    if (!el || el.dataset.loaded) return;
    
    const { postCount, uniqueTagCount, totalChars, FOUNDED } = window.__siteStats ?? {};
    if (!postCount) return;
    
    const now = new Date();
    const founded = new Date(FOUNDED);
    const runningDays = Math.floor((now - founded) / (1000 * 60 * 60 * 24));
    const lastUpdated = now.toISOString().split("T")[0];
    
    function booksEquivalent(chars) {
      // 书籍字数数据（字数从少到多，10万字以内）
      const books = [
        { name: "《变形记》", chars: 20000 },
        { name: "《动物农场》", chars: 30000 },
        { name: "《小王子》", chars: 40000 },
        { name: "《老人与海》", chars: 50000 },
        { name: "《了不起的盖茨比》", chars: 50000 },
        { name: "《边城》", chars: 60000 },
        { name: "《麦田里的守望者》", chars: 70000 },
        { name: "《呐喊》", chars: 70000 },
        { name: "《活着》", chars: 110000 },
        { name: "《骆驼祥子》", chars: 100000 },
      ];
      
      // 找到最接近的书
      let lower = null, upper = null;
      for (let i = 0; i < books.length; i++) {
        if (books[i].chars <= chars) lower = books[i];
        if (books[i].chars > chars && !upper) upper = books[i];
      }
      
      // 生成描述
      if (!lower) {
        // 还没写到第一本书
        const percent = Math.round((chars / books[0].chars) * 100);
        return `相当于 ${books[0].name} 的 ${percent}%`;
      }
      
      if (!upper) {
        // 超过所有书
        const times = (chars / books[books.length - 1].chars).toFixed(1);
        return `超过 ${books[books.length - 1].name} ${times} 倍了！`;
      }
      
      // 在两本书之间
      const percent = Math.round(((chars - lower.chars) / (upper.chars - lower.chars)) * 100);
      if (percent < 10) {
        return `刚超过 ${lower.name}`;
      } else if (percent < 50) {
        return `超过 ${lower.name}，达到 ${upper.name} 的 ${percent}%`;
      } else if (percent < 90) {
        return `快赶上 ${upper.name} 了（${percent}%）`;
      } else {
        return `马上超越 ${upper.name}！`;
      }
    }
    
    el.innerHTML = `
      <div class="stats-row">
        <div>📝 <span>文章总数</span><strong>${postCount} 篇</strong></div>
        <div>🏷️ <span>标签总数</span><strong>${uniqueTagCount} 个</strong></div>
        <div>✍️ <span>全站字数</span><strong>约 ${totalChars.toLocaleString("zh-CN")} 字</strong></div>
        <div>📚 <span>废话产量</span><strong>${booksEquivalent(totalChars)}</strong></div>
      </div>
      <div class="stats-row">
        <div>📅 <span>建站时间</span><strong>${FOUNDED}</strong></div>
        <div>⏱️ <span>已运行</span><strong>${runningDays} 天</strong></div>
        <div>🔄 <span>最后更新</span><strong>${lastUpdated}</strong></div>
      </div>
    `;
    el.dataset.loaded = "true";
  }
  
  // 立即执行（如果 DOM 已就绪）
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderStats);
  } else {
    renderStats();
  }
  
  // Astro View Transitions 支持
  document.addEventListener("astro:page-load", renderStats);
</script>

<script is:inline>
  (function () {
    var backToTopBtn = null;
    var progressBar = null;

    function initBackToTop() {
      if (!backToTopBtn) {
        backToTopBtn = document.createElement("button");
        backToTopBtn.className = "back-to-top";
        backToTopBtn.setAttribute("aria-label", "返回顶部");
        backToTopBtn.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>';
        backToTopBtn.addEventListener("click", function () {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        document.body.appendChild(backToTopBtn);
      }
    }

    function initProgressBar() {
      if (!progressBar) {
        progressBar = document.createElement("div");
        progressBar.id = "reading-progress-bar";
        document.body.appendChild(progressBar);
      }
    }

    function onScroll() {
      if (backToTopBtn) {
        backToTopBtn.classList.toggle("visible", window.scrollY > 280);
      }
      if (progressBar) {
        var total = document.documentElement.scrollHeight - window.innerHeight;
        var p = total > 0 ? (window.scrollY / total) * 100 : 0;
        progressBar.style.width = Math.min(100, Math.max(0, p)) + "%";
      }
    }

    function init() {
      initBackToTop();
      initProgressBar();
      onScroll();
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("astro:page-load", init);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

<script is:inline>
  (function () {
    function syncTitleWidth() {
      var t = document.querySelector(".side-home-title");
      var b = document.querySelector(".side-home-bio");
      if (!t || !b || b.dataset.widthSynced) return;
      b.style.maxWidth = "";
      b.style.width = "";
      var w = t.getBoundingClientRect().width;
      if (w > 0) {
        b.style.width = w + "px";
        b.dataset.widthSynced = "true";
      }
    }
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", syncTitleWidth);
    else syncTitleWidth();
    document.addEventListener("astro:page-load", syncTitleWidth);
  })();
</script><script is:inline src="/scripts/anime-bg.js"></script>


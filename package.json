{
  "name": "charm-root",
  "license": "MIT",
  "private": true,
  "scripts": {
    "playground:dev": "pnpm --filter playground dev",
    "playground:build": "pnpm --filter playground build --outDir ../dist",
    "package:check": "pnpm --filter astro-charm check",
    "package:release": "changeset publish",
    "format": "prettier --write  \"**/*.{js,ts,css,astro}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "puppeteer", "sharp"]
  },
  "dependencies": {
    "@iconify-json/simple-icons": "^1.2.59",
    "@iconify-json/solar": "^1.2.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "astro": "^5.15.9",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
